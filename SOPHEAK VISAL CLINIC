<!DOCTYPE html>
<html lang="km"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>កាលវិភាគតាមផ្នែក</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Khmer:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#f4f6f9;--ink:#1c2430;--sub:#6b7686;--line:#e6e9ef;--brand:#2f6fed;--r:14px;--sh:0 1px 2px rgba(20,25,40,.04),0 8px 24px rgba(20,25,40,.06)}
*{box-sizing:border-box}body{margin:0;font-family:'Noto Sans Khmer',sans-serif;background:var(--bg);color:var(--ink);font-size:14px}
#app{max-width:1180px;margin:0 auto;padding:16px 14px 60px}
h1{font-size:19px;margin:0}.top{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:14px}
.tabs{display:flex;gap:5px;background:#fff;padding:5px;border-radius:12px;box-shadow:var(--sh)}
.tab{padding:8px 14px;border-radius:9px;cursor:pointer;font-weight:600;color:var(--sub);white-space:nowrap}.tab.on{background:var(--brand);color:#fff}
.card{background:#fff;border-radius:var(--r);box-shadow:var(--sh);padding:16px;margin-bottom:14px}
.nav{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:14px}
.btn{border:1px solid var(--line);background:#fff;border-radius:9px;padding:7px 12px;cursor:pointer;font-family:inherit;font-weight:600;font-size:13px;color:var(--ink)}
.btn:hover{background:#f0f2f6}.btn.p{background:var(--brand);color:#fff;border-color:var(--brand)}
.lbl{font-weight:700;font-size:16px;min-width:170px;text-align:center}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:14px}
.dept{border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#fff}
.dh{padding:10px 12px;color:#fff;font-weight:700;display:flex;justify-content:space-between}
.row{display:flex;align-items:center;gap:8px;padding:6px 10px;border-top:1px solid var(--line)}
.row .sl{width:62px;color:var(--sub);font-size:12px;flex-shrink:0}
.cell{flex:1;min-height:30px;border-radius:8px;padding:5px 8px;cursor:pointer;font-size:12.5px;border:1px solid transparent;display:flex;align-items:center}
.cell:hover{border-color:var(--line)}.cell.e{color:#c3c9d3}.cell.f{font-weight:600}
input.ed,select.ed{width:100%;padding:5px;border:1px solid var(--brand);border-radius:7px;font-family:inherit;font-size:12.5px}
table{width:100%;border-collapse:collapse;font-size:12.8px}
th{background:#f7f8fb;color:var(--sub);padding:8px 4px;border-bottom:1px solid var(--line);position:sticky;top:0}
td{padding:5px 4px;border-bottom:1px solid var(--line);text-align:center}
td.d{text-align:left;font-weight:700;white-space:nowrap;padding-left:8px}td.d small{display:block;color:var(--sub);font-weight:400;font-size:10.5px}
tr.we td.d{color:#e05252}tr.td{background:#fff3b0}
.chips{display:flex;gap:6px;flex-wrap:wrap}.chip{padding:7px 13px;border-radius:20px;border:1.5px solid var(--line);cursor:pointer;font-weight:600;background:#fff}
.x{color:#e05252;cursor:pointer;font-weight:700;margin-left:4px}
.names{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0}.nm{border:1px solid var(--line);border-radius:20px;padding:5px 12px;background:#fbfcfe}
.add{display:flex;gap:8px;margin-top:8px}.add input{flex:1;padding:8px;border:1px solid var(--line);border-radius:9px;font-family:inherit}
.toast{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);background:#1c2430;color:#fff;padding:9px 16px;border-radius:10px;opacity:0;transition:.25s;pointer-events:none}.toast.s{opacity:1}
.pn{display:none}.pn.on{display:block}
@media print{@page{size:landscape;margin:8mm}*{-webkit-print-color-adjust:exact;print-color-adjust:exact}.top,.nav,.toast,.chips,.no-p{display:none!important}.card{box-shadow:none}}
</style></head><body><div id="app">
<div class="top"><h1>កាលវិភាគតាមផ្នែក</h1>
<div class="tabs"><div class="tab on" data-p="day">ប្រចាំថ្ងៃ</div><div class="tab" data-p="month">ប្រចាំខែ</div><div class="tab" data-p="staff">បុគ្គលិក</div><div class="tab" data-p="count">ចំនួនវេន</div></div></div>

<div class="pn on" id="p-day"><div class="card">
<div class="nav"><button class="btn" id="dPrev">‹</button><div class="lbl" id="dLbl"></div><button class="btn" id="dNext">›</button>
<input type="date" class="btn" id="dPick"><button class="btn" id="dToday">ថ្ងៃនេះ</button><button class="btn no-p" onclick="print()">🖨️ ព្រីន</button></div>
<div class="grid" id="dGrid"></div></div></div>

<div class="pn" id="p-month"><div class="card">
<div class="nav"><button class="btn" id="mPrev">‹</button><div class="lbl" id="mLbl"></div><button class="btn" id="mNext">›</button>
<button class="btn" id="mToday">ខែនេះ</button><button class="btn no-p" onclick="print()">🖨️ ព្រីន</button></div>
<div class="chips" id="mChips" style="margin-bottom:12px"></div><div style="overflow-x:auto" id="mWrap"></div></div></div>

<div class="pn" id="p-staff"><div class="card"><div style="font-weight:700;margin-bottom:8px">គ្រប់គ្រងផ្នែក</div>
<div class="names" id="depList"></div>
<form class="add" id="depForm"><input id="depIcon" placeholder="😀" style="flex:0 0 60px;text-align:center"><input id="depName" placeholder="ឈ្មោះផ្នែកថ្មី — ឧ. Lab, ឱសថស្ថាន">
<input type="color" id="depColor" value="#2f6fed" style="flex:0 0 46px;padding:2px"><button class="btn p">+ បន្ថែមផ្នែក</button></form></div>
<div class="card"><div style="font-weight:700;margin-bottom:8px">បុគ្គលិកតាមផ្នែក</div><div class="chips" id="sChips" style="margin-bottom:6px"></div>
<div class="names" id="sNames"></div>
<form class="add" id="sForm"><input id="sNew" placeholder="ឈ្មោះ — ឧ. Dr.Sok Dara"><button class="btn p">+ បន្ថែម</button></form></div></div>

<div class="pn" id="p-count"><div class="card"><div class="nav"><button class="btn" id="cPrev">‹</button><div class="lbl" id="cLbl"></div><button class="btn" id="cNext">›</button></div><div id="cWrap"></div></div></div>
</div><div class="toast" id="toast"></div>

<script type="module">
import {initializeApp} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import {initializeFirestore,persistentLocalCache,doc,setDoc,onSnapshot} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";
/* ===== Firebase project ថ្មីរបស់កម្មវិធីនេះ (ដាច់ដោយឡែកពី SOPHEAK VISAL CLINIC) =====
   បង្កើត project ថ្មីក្នុង Firebase Console → ចម្លង config មកដាក់ទីនេះ។
   បើទុកជា PASTE_... កម្មវិធីនឹងរក្សាទុកក្នុង browser នេះ (localStorage) ជំនួសសិន។ */
const cfg={apiKey:"AIzaSyBdzGaQHj_lRdLARHAIruY-Ha_USzKMiwk",authDomain:"sopheak-visal-clinic.firebaseapp.com",projectId:"sopheak-visal-clinic",storageBucket:"sopheak-visal-clinic.firebasestorage.app",messagingSenderId:"89092779964",appId:"1:89092779964:web:775cb69d9f88580ddd45b9"};
const USE_FB=cfg.apiKey.indexOf('PASTE')!==0, LS='deptScheduleApp_v1';
const ref=USE_FB?doc(initializeFirestore(initializeApp(cfg),{localCache:persistentLocalCache()}),'deptSchedule','main'):null;

const MN=['មករា','កុម្ភៈ','មីនា','មេសា','ឧសភា','មិថុនា','កក្កដា','សីហា','កញ្ញា','តុលា','វិច្ឆិកា','ធ្នូ'];
const DW=['អាទិត្យ','ចន្ទ','អង្គារ','ពុធ','ព្រហស្បតិ៍','សុក្រ','សៅរ៍'];
const cols3=()=>[{id:'c1',label:'ព្រឹក'},{id:'c2',label:'រសៀល'},{id:'c3',label:'យប់'}];
const DEF=[{id:'doctor',name:'គ្រូពេទ្យ',icon:'🩺',color:'#2f6fed'},{id:'nurse',name:'Nurse',icon:'💉',color:'#0f9d7a'},{id:'eye',name:'ភ្នែក',icon:'👁️',color:'#8a4fd6'},{id:'dental',name:'ធ្មេញ',icon:'🦷',color:'#e07b00'}].map(d=>({...d,cols:cols3()}));
let S={depts:DEF,staff:{doctor:[],nurse:[],eye:[],dental:[]},sched:{}};
let day=new Date(),my=day.getFullYear(),mm=day.getMonth()+1,cy=my,cm=mm,curDept='doctor',staffDept='doctor',editing=false;
const $=id=>document.getElementById(id),p2=n=>(n<10?'0':'')+n,ds=d=>d.getFullYear()+'-'+p2(d.getMonth()+1)+'-'+p2(d.getDate());
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const key=(d,c)=>d+'__'+c;
const get=(date,dept,col)=>(S.sched[date]||{})[key(dept,col)]||'';
function save(){if(USE_FB)setDoc(ref,S).catch(e=>toast('⚠ '+e.message));else try{localStorage.setItem(LS,JSON.stringify(S))}catch(e){toast('⚠ '+e.message)}}
function toast(m){const t=$('toast');t.textContent=m;t.classList.add('s');clearTimeout(toast.t);toast.t=setTimeout(()=>t.classList.remove('s'),2000)}
const dept=id=>S.depts.find(d=>d.id===id);

function load(d){S={depts:d.depts||DEF,staff:d.staff||{},sched:d.sched||{}};S.depts.forEach(x=>S.staff[x.id]=S.staff[x.id]||[]);
  if(!dept(curDept))curDept=(S.depts[0]||{}).id;if(!dept(staffDept))staffDept=(S.depts[0]||{}).id}
if(USE_FB){
  onSnapshot(ref,snap=>{if(snap.exists())load(snap.data());else save();if(!editing)renderAll()},
    e=>{$('dGrid').innerHTML='<div>⚠ មិនអាចភ្ជាប់ Firestore: '+esc(e.message)+'</div>'});
}else{
  try{const r=localStorage.getItem(LS);if(r)load(JSON.parse(r))}catch(e){}
  renderAll();
}

document.querySelectorAll('.tab').forEach(t=>t.onclick=()=>{
  document.querySelectorAll('.tab').forEach(x=>x.classList.remove('on'));document.querySelectorAll('.pn').forEach(x=>x.classList.remove('on'));
  t.classList.add('on');$('p-'+t.dataset.p).classList.add('on');renderAll()});

function renderAll(){renderDay();renderMonth();renderStaff();renderCount()}

/* ---------- DAY ---------- */
function shiftDay(n){day=new Date(day.getFullYear(),day.getMonth(),day.getDate()+n);renderDay()}
$('dPrev').onclick=()=>shiftDay(-1);$('dNext').onclick=()=>shiftDay(1);$('dToday').onclick=()=>{day=new Date();renderDay()};
$('dPick').onchange=e=>{if(e.target.value){const p=e.target.value.split('-');day=new Date(+p[0],+p[1]-1,+p[2]);renderDay()}};
function renderDay(){
  const d=ds(day);$('dLbl').textContent=DW[day.getDay()]+' '+day.getDate()+' '+MN[day.getMonth()]+' '+day.getFullYear();$('dPick').value=d;
  $('dGrid').innerHTML=S.depts.map(D=>'<div class="dept"><div class="dh" style="background:'+D.color+'"><span>'+D.icon+' '+esc(D.name)+'</span></div>'+
    D.cols.map(c=>cellRow(d,D,c)).join('')+'</div>').join('');
}
function cellRow(d,D,c){const v=get(d,D.id,c.id);
  return '<div class="row"><span class="sl">'+esc(c.label)+'</span><div class="cell '+(v?'f':'e')+'" data-d="'+d+'" data-dp="'+D.id+'" data-c="'+c.id+'" '+(v?'style="background:'+D.color+'1f"':'')+'>'+(v?esc(v):'—')+'</div></div>'}

/* ---------- MONTH ---------- */
$('mPrev').onclick=()=>{mm--;if(mm<1){mm=12;my--}renderMonth()};$('mNext').onclick=()=>{mm++;if(mm>12){mm=1;my++}renderMonth()};
$('mToday').onclick=()=>{const n=new Date();my=n.getFullYear();mm=n.getMonth()+1;renderMonth()};
function chips(id,cur){return S.depts.map(D=>'<div class="chip" data-dp="'+D.id+'" style="'+(D.id===cur?'background:'+D.color+';color:#fff;border-color:'+D.color:'')+'">'+D.icon+' '+esc(D.name)+'</div>').join('')}
$('mChips').onclick=e=>{const c=e.target.closest('.chip');if(c){curDept=c.dataset.dp;renderMonth()}};
function renderMonth(){
  $('mLbl').textContent=MN[mm-1]+' '+my;$('mChips').innerHTML=chips('m',curDept);
  const D=dept(curDept)||S.depts[0];if(!D)return;
  const n=new Date(my,mm,0).getDate(),t=ds(new Date());
  let h='<table><thead><tr><th style="text-align:left">កាលបរិច្ឆេទ</th>'+D.cols.map(c=>'<th>'+esc(c.label)+(editing?'':'')+' <span class="x no-p" data-del="'+c.id+'" title="លុបជួរ">×</span></th>').join('')+
    '<th class="no-p"><span class="x" style="color:var(--brand)" id="addCol" title="បន្ថែមជួរ">+</span></th></tr></thead><tbody>';
  for(let i=1;i<=n;i++){const d=my+'-'+p2(mm)+'-'+p2(i),w=new Date(my,mm-1,i).getDay();
    h+='<tr class="'+(w==0||w==6?'we ':'')+(d===t?'td':'')+'"><td class="d">'+i+'/'+p2(mm)+'<small>'+DW[w]+'</small></td>'+D.cols.map(c=>{const v=get(d,D.id,c.id);
      return '<td><div class="cell '+(v?'f':'e')+'" data-d="'+d+'" data-dp="'+D.id+'" data-c="'+c.id+'" '+(v?'style="background:'+D.color+'1f"':'')+'>'+(v?esc(v):'—')+'</div></td>'}).join('')+'<td class="no-p"></td></tr>'}
  $('mWrap').innerHTML=h+'</tbody></table>';
}
$('mWrap').addEventListener('click',e=>{
  const D=dept(curDept);
  if(e.target.id==='addCol'){const l=prompt('ឈ្មោះជួរថ្មី (ឧ. ព្រឹក ២)៖');if(l){D.cols.push({id:'c'+Date.now(),label:l});save();renderAll()}}
  const del=e.target.dataset.del;if(del&&D.cols.length>1&&confirm('លុបជួរនេះ? (ទិន្នន័យចាស់មិនត្រូវលុបទេ)')){D.cols=D.cols.filter(c=>c.id!==del);save();renderAll()}
});

/* ---------- INLINE EDITOR (day + month) ---------- */
document.addEventListener('click',e=>{const c=e.target.closest('.cell');if(c&&c.dataset.d&&!editing)edit(c)});
function edit(cell){
  editing=true;const d=cell.dataset.d,dp=cell.dataset.dp,col=cell.dataset.c,cur=get(d,dp,col);
  const names=[...new Set([...(S.staff[dp]||[])])];
  const id='dl'+Date.now();
  cell.innerHTML='<input class="ed" list="'+id+'" value="'+esc(cur)+'" placeholder="វាយ/ជ្រើសឈ្មោះ..."><datalist id="'+id+'">'+names.map(n=>'<option value="'+esc(n)+'">').join('')+'</datalist>';
  const inp=cell.querySelector('input');inp.focus();inp.select();let done=false;
  const fin=(cancel,dir)=>{if(done)return;done=true;editing=false;
    if(!cancel){const v=inp.value.trim();if(v!==cur){
      if(v){const D=dept(dp);const dup=D.cols.some(c=>c.id!==col&&c.label===D.cols.find(x=>x.id===col).label&&get(d,dp,c.id)===v);
        if(dup){toast('⚠ '+v+' មានរួចហើយក្នុងក្រុមនេះ');renderAll();return}}
      (S.sched[d]=S.sched[d]||{})[key(dp,col)]=v;save();toast('រក្សាទុករួចរាល់ ✓')}}
    renderAll();
    if(dir){const all=[...document.querySelectorAll('.pn.on .cell')];const i=all.findIndex(x=>x.dataset.d===d&&x.dataset.dp===dp&&x.dataset.c===col);const nx=all[i+dir];if(nx)edit(nx)}};
  inp.addEventListener('keydown',ev=>{if(ev.isComposing||ev.keyCode===229)return;
    if(ev.key==='Enter'||ev.key==='Tab'){ev.preventDefault();fin(false,ev.shiftKey?-1:1)}else if(ev.key==='Escape'){ev.preventDefault();fin(true)}});
  inp.addEventListener('blur',()=>setTimeout(()=>fin(false),80));
}

/* ---------- STAFF ---------- */
$('sChips').onclick=e=>{const c=e.target.closest('.chip');if(c){staffDept=c.dataset.dp;renderStaff()}};
function renderDeps(){
  $('depList').innerHTML=S.depts.map(D=>'<span class="nm" style="border-color:'+D.color+'">'+D.icon+' '+esc(D.name)+' <span class="x" data-del="'+D.id+'">×</span></span>').join('')||'<span style="color:var(--sub)">មិនទាន់មានផ្នែក</span>'}
$('depList').onclick=e=>{const id=e.target.dataset.del;if(!id)return;const D=dept(id);
  if(!confirm('លុបផ្នែក "'+D.name+'"? (ទិន្នន័យវេនចាស់ៗរក្សាទុកក្នុងឯកសារ ប៉ុន្តែលែងបង្ហាញ)'))return;
  S.depts=S.depts.filter(x=>x.id!==id);if(!dept(curDept))curDept=(S.depts[0]||{}).id;if(!dept(staffDept))staffDept=(S.depts[0]||{}).id;
  save();renderAll();toast('លុបផ្នែករួចរាល់ ✓')};
$('depForm').onsubmit=e=>{e.preventDefault();const n=$('depName').value.trim();if(!n){toast('សូមបញ្ចូលឈ្មោះផ្នែក');return}
  const id='d'+Date.now();S.depts.push({id,name:n,icon:$('depIcon').value.trim()||'🏥',color:$('depColor').value,cols:cols3()});S.staff[id]=[];
  if(!curDept)curDept=id;if(!staffDept)staffDept=id;$('depName').value='';$('depIcon').value='';save();renderAll();toast('បន្ថែមផ្នែករួចរាល់ ✓')};
function renderStaff(){renderDeps();
  $('sChips').innerHTML=chips('s',staffDept);const l=S.staff[staffDept]||[];
  $('sForm').style.display=dept(staffDept)?'':'none';
  $('sNames').innerHTML=l.length?l.map((n,i)=>'<span class="nm">'+esc(n)+' <span class="x" data-i="'+i+'">×</span></span>').join(''):'<span style="color:var(--sub)">មិនទាន់មានឈ្មោះ</span>';
}
$('sNames').onclick=e=>{const i=e.target.dataset.i;if(i!==undefined&&confirm('លុបឈ្មោះនេះ? (វេនចាស់នៅដដែល)')){S.staff[staffDept].splice(+i,1);save();renderStaff()}};
$('sForm').onsubmit=e=>{e.preventDefault();const v=$('sNew').value.trim();if(!v)return;
  S.staff[staffDept]=S.staff[staffDept]||[];if(!S.staff[staffDept].includes(v))S.staff[staffDept].push(v);$('sNew').value='';save();renderStaff();toast('បន្ថែមរួចរាល់ ✓')};

/* ---------- COUNT ---------- */
$('cPrev').onclick=()=>{cm--;if(cm<1){cm=12;cy--}renderCount()};$('cNext').onclick=()=>{cm++;if(cm>12){cm=1;cy++}renderCount()};
function renderCount(){
  $('cLbl').textContent=MN[cm-1]+' '+cy;const pre=cy+'-'+p2(cm);
  $('cWrap').innerHTML=S.depts.map(D=>{const m={};
    Object.keys(S.sched).filter(k=>k.indexOf(pre)===0).forEach(d=>D.cols.forEach(c=>{
      const raw=get(d,D.id,c.id);if(!raw)return;const n=raw.split('(')[0].trim();if(!n)return;
      const o=m[n]=m[n]||{day:0,night:0};if(c.label.indexOf('យប់')!==-1)o.night++;else o.day++}));
    const rows=Object.keys(m).sort((a,b)=>(m[b].day+m[b].night)-(m[a].day+m[a].night));
    return '<h3 style="color:'+D.color+';margin:14px 0 6px">'+D.icon+' '+esc(D.name)+'</h3>'+(rows.length?'<table><thead><tr><th style="text-align:left">ឈ្មោះ</th><th>ថ្ងៃ</th><th>យប់</th><th>សរុប</th></tr></thead><tbody>'+
      rows.map(n=>'<tr><td style="text-align:left">'+esc(n)+'</td><td>'+m[n].day+'</td><td>'+m[n].night+'</td><td><b>'+(m[n].day+m[n].night)+'</b></td></tr>').join('')+'</tbody></table>':'<div style="color:var(--sub)">មិនមានវេនទេ</div>')}).join('');
}
</script></body></html>
